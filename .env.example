# Copy to .env. PostgreSQL is mandatory in production; SQLite is local-only.
DATABASE_URL=sqlite:///./data/campus.db
APP_ENV=development
FRONTEND_ORIGIN=campus-buddy-mvp.vercel.app
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campus-sources
STORAGE_BACKEND=local
EMBEDDING_MODEL_PATH=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/integrations/google/callback
TOKEN_ENCRYPTION_KEY=
CAMPUS_ACCESS_TOKEN=
CAMPUS_TENANT_ID=
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
