# Copy to .env. PostgreSQL is mandatory in production; SQLite is local-only.
DATABASE_URL=sqlite:///./data/campus.db
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campus-sources
STORAGE_BACKEND=local
# Requests allowed per user per minute. Lowering this can lock out normal use.
RATE_LIMIT_PER_MINUTE=120
# Only when sharing a database with another Alembic project, such as campusos_alembic_version.
ALEMBIC_VERSION_TABLE=alembic_version
EMBEDDING_MODEL_PATH=
# Local AI. All optional: without them, CampusOS stays deterministic and needs no model.
# auto uses Gemini only when a key is set. Options: auto, none, ollama, gemini.
LLM_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
# Best measured on 8 GB VRAM. qwen3.5:2b is the lower-memory option. See artifacts/model-benchmark.json.
OLLAMA_MODEL=qwen3.5:9b
# Must produce 1024 dimensions, such as bge-m3. Re-index documents after changing it.
OLLAMA_EMBEDDING_MODEL=
OLLAMA_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=90
# regex uses rules only. hybrid sends long or unmatched questions to the tool-calling agent.
ROUTING_MODE=regex
# Folder of a downloaded cross-encoder, such as data/models/bge-reranker-v2-m3.
RERANKER_MODEL_PATH=
RETRIEVAL_MIN_SIMILARITY=0.45
# pymupdf reads the text layer. docling also recovers tables and runs OCR on scanned pages.
DOCUMENT_PARSER=pymupdf
# Folder of a downloaded faster-whisper model. Audio is transcribed in memory and never stored.
SPEECH_MODEL=data/models/faster-whisper-small
# A language code such as en, or auto to detect it.
SPEECH_LANGUAGE=en
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/integrations/google/callback
TOKEN_ENCRYPTION_KEY=
CAMPUS_ACCESS_TOKEN=
CAMPUS_TENANT_ID=
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
