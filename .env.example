# Copy to .env. PostgreSQL is mandatory in production; SQLite is local-only.
DATABASE_URL=sqlite:///./data/campus.db
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3001
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional operator-approved Google admin exception: exact email AND verified Auth UUID.
# Also requires an active institution_admin membership; never permits Gmail enrollment.
GOOGLE_ADMIN_EMAIL=
GOOGLE_ADMIN_USER_ID=
# Temporary development/test student only. Both identity pins and tenant are
# mandatory. Never grants enrollment/admin privileges; normal join code required.
GOOGLE_TEST_STUDENT_ENABLED=false
GOOGLE_TEST_STUDENT_EMAIL=
GOOGLE_TEST_STUDENT_USER_ID=
GOOGLE_TEST_STUDENT_TENANT_ID=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campus-sources
STORAGE_BACKEND=local
EMBEDDING_MODEL_PATH=
EMBEDDING_PROVIDER=auto
SEMANTIC_MIN_SCORE=0.78
OCR_ENABLED=true
# No automatic downloads: see docs/phase6.md for explicit local setup.
OCR_TESSDATA_PATH=.scratch/tessdata
OCR_LANGUAGES=eng
SPEECH_ENABLED=true
SPEECH_MODEL_PATH=.scratch/whisper-tiny
# Optional. Use a private authenticated Redis; leave off without one.
REDIS_ENABLED=false
REDIS_URL=
CACHE_TTL_SECONDS=30
INGESTION_QUEUE_LIMIT=100
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_DATA_POLICY=disabled
LLM_POLICY_REFERENCE=
LLM_TIMEOUT_SECONDS=8
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/v1/integrations/google/callback
TOKEN_ENCRYPTION_KEY=
CAMPUS_ACCESS_TOKEN=
CAMPUS_TENANT_ID=
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
