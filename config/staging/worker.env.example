# Template only: same dedicated staging database/bucket as the API, separate trusted worker credentials.
APP_ENV=production
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
STORAGE_BACKEND=supabase
GEMINI_API_KEY=
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_DATA_POLICY=disabled
EMBEDDING_MODEL_PATH=/app/assets/semantic-e5
EMBEDDING_PROVIDER=onnx
SEMANTIC_MIN_SCORE=0.78
OCR_ENABLED=false
OCR_TESSDATA_PATH=/app/assets/tessdata
OCR_LANGUAGES=eng
SPEECH_ENABLED=false
# API and worker must use the same private Redis for commit invalidation.
REDIS_ENABLED=false
REDIS_URL=
CACHE_TTL_SECONDS=30
INGESTION_QUEUE_LIMIT=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
CAMPUS_ACCESS_TOKEN=
CAMPUS_TENANT_ID=
