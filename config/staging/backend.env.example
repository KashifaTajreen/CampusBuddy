# Template only. Inject secrets through your staging process manager; do not edit the development .env.
APP_ENV=production
DATABASE_URL=
FRONTEND_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
STORAGE_BACKEND=supabase
GEMINI_API_KEY=
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_DATA_POLICY=disabled
LLM_POLICY_REFERENCE=
LLM_TIMEOUT_SECONDS=8
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
EMBEDDING_MODEL_PATH=/app/assets/semantic-e5
EMBEDDING_PROVIDER=onnx
SEMANTIC_MIN_SCORE=0.78
OCR_ENABLED=false
# Enable only after mounting approved local assets; see docs/phase6.md.
OCR_TESSDATA_PATH=/app/assets/tessdata
OCR_LANGUAGES=eng
SPEECH_ENABLED=false
SPEECH_MODEL_PATH=/app/assets/whisper-tiny
REDIS_ENABLED=false
REDIS_URL=
CACHE_TTL_SECONDS=30
INGESTION_QUEUE_LIMIT=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
CAMPUS_ACCESS_TOKEN=
CAMPUS_TENANT_ID=
